### FamilyCart smoke tests
### Run each request from top to bottom ("Send Request" above each one).
### Each request says what result to expect. Later requests reuse values
### (tokens, ids) from earlier responses automatically, so keep the order.
###
### Start the API first:  dotnet run --project FamilyCart.API --launch-profile http

@host = http://localhost:5208

########################################################################
# 1. AUTH
########################################################################

### 1a. Register Alice  → expect 200 (400 "DuplicateEmail" is fine on a re-run)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Alice",
  "lastName": "Tester",
  "username": "alice",
  "email": "alice@test.com",
  "password": "Passw0rd!"
}

### 1b. Register Bob  → expect 200 (400 on a re-run is fine)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Bob",
  "lastName": "Tester",
  "username": "bob",
  "email": "bob@test.com",
  "password": "Passw0rd!"
}

### 1c. Log in Alice  → expect 200 with a token
# @name alice
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "alice@test.com",
  "password": "Passw0rd!"
}

### 1d. Log in Bob  → expect 200 with a token
# @name bob
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "bob@test.com",
  "password": "Passw0rd!"
}

### 1e. Wrong password  → expect 401 "Invalid Password"
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "alice@test.com",
  "password": "WrongPassword1!"
}

### 1f. No token  → expect 401
GET {{host}}/api/family

########################################################################
# 2. FAMILIES
########################################################################

### 2a. Alice creates a family  → expect 200 with id + inviteCode
# @name aliceFamily
POST {{host}}/api/family
Authorization: Bearer {{alice.response.body.$.token}}
Content-Type: application/json

{
  "familyName": "Alice Household"
}

### 2b. Bob creates his own family  → expect 200
# @name bobFamily
POST {{host}}/api/family
Authorization: Bearer {{bob.response.body.$.token}}
Content-Type: application/json

{
  "familyName": "Bob Household"
}

### 2c. Alice lists her families  → expect 200, only "Alice Household"
GET {{host}}/api/family
Authorization: Bearer {{alice.response.body.$.token}}

########################################################################
# 3. STORES  (changed today — every store must belong to a family)
########################################################################

### 3a. Alice creates a store  → expect 200, familyId = Alice's family, NO instacartStoreId field
# @name aliceStore
POST {{host}}/api/store
Authorization: Bearer {{alice.response.body.$.token}}
Content-Type: application/json

{
  "name": "Publix",
  "familyId": {{aliceFamily.response.body.$.id}}
}

### 3b. Bob creates a store  → expect 200
# @name bobStore
POST {{host}}/api/store
Authorization: Bearer {{bob.response.body.$.token}}
Content-Type: application/json

{
  "name": "Costco",
  "familyId": {{bobFamily.response.body.$.id}}
}

### 3c. Alice lists her stores  → expect 200, ONLY "Publix" (not Bob's Costco)
GET {{host}}/api/store/{{aliceFamily.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}

### 3d. Bob tries to list Alice's stores  → expect 403
GET {{host}}/api/store/{{aliceFamily.response.body.$.id}}
Authorization: Bearer {{bob.response.body.$.token}}

### 3e. Bob tries to create a store in Alice's family  → expect 403
POST {{host}}/api/store
Authorization: Bearer {{bob.response.body.$.token}}
Content-Type: application/json

{
  "name": "Sneaky Store",
  "familyId": {{aliceFamily.response.body.$.id}}
}

########################################################################
# 4. PRODUCTS  (changed today)
########################################################################

### 4a. Alice creates a product  → expect 200, NO type / instacartProductId fields
# @name beef
POST {{host}}/api/product
Authorization: Bearer {{alice.response.body.$.token}}
Content-Type: application/json

{
  "name": "Ground Beef",
  "price": 7.99,
  "familyId": {{aliceFamily.response.body.$.id}},
  "storeId": {{aliceStore.response.body.$.id}}
}

### 4b. Alice creates a second product  → expect 200
# @name turkey
POST {{host}}/api/product
Authorization: Bearer {{alice.response.body.$.token}}
Content-Type: application/json

{
  "name": "Ground Turkey",
  "price": 6.49,
  "familyId": {{aliceFamily.response.body.$.id}},
  "storeId": {{aliceStore.response.body.$.id}}
}

### 4c. Alice adds a product to BOB's store  → expect 403 "This store does not belong to your family."
POST {{host}}/api/product
Authorization: Bearer {{alice.response.body.$.token}}
Content-Type: application/json

{
  "name": "Wrong Store Item",
  "price": 1.00,
  "familyId": {{aliceFamily.response.body.$.id}},
  "storeId": {{bobStore.response.body.$.id}}
}

### 4d. List products in Alice's store  → expect 200, both products
GET {{host}}/api/product/store/{{aliceStore.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}

### 4e. Bob lists products in Alice's store  → expect 403 (this check used to be skipped for "global" stores)
GET {{host}}/api/product/store/{{aliceStore.response.body.$.id}}
Authorization: Bearer {{bob.response.body.$.token}}

### 4f. Search "ground"  → expect 200, both Ground Beef and Ground Turkey
GET {{host}}/api/product/search?storeId={{aliceStore.response.body.$.id}}&query=ground
Authorization: Bearer {{alice.response.body.$.token}}

### 4g. Bob searches Alice's store  → expect 403
GET {{host}}/api/product/search?storeId={{aliceStore.response.body.$.id}}&query=ground
Authorization: Bearer {{bob.response.body.$.token}}

### 4h. Alice renames a product (partial update)  → expect 200, new name, price still 6.49
PATCH {{host}}/api/product/{{turkey.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}
Content-Type: application/json

{
  "name": "Ground Turkey 93/7",
  "price": null
}

### 4i. Bob tries to edit Alice's product  → expect 403
PATCH {{host}}/api/product/{{turkey.response.body.$.id}}
Authorization: Bearer {{bob.response.body.$.token}}
Content-Type: application/json

{
  "name": "Hacked",
  "price": null
}

########################################################################
# 5. SHOPPING LISTS
########################################################################

### 5a. Alice creates a list for her store  → expect 200
# @name list
POST {{host}}/api/shoppinglist
Authorization: Bearer {{alice.response.body.$.token}}
Content-Type: application/json

{
  "listName": "Weekly Groceries",
  "familyId": {{aliceFamily.response.body.$.id}},
  "storeId": {{aliceStore.response.body.$.id}}
}

### 5b. Alice creates a list using BOB's store  → expect 403
POST {{host}}/api/shoppinglist
Authorization: Bearer {{alice.response.body.$.token}}
Content-Type: application/json

{
  "listName": "Wrong Store List",
  "familyId": {{aliceFamily.response.body.$.id}},
  "storeId": {{bobStore.response.body.$.id}}
}

### 5c. Alice renames the list  → expect 200
PUT {{host}}/api/shoppinglist/{{list.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}
Content-Type: application/json

{
  "listName": "Weekly Groceries (Renamed)"
}

### 5d. Alice lists her family's lists  → expect 200, one list
GET {{host}}/api/shoppinglist/family/{{aliceFamily.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}

########################################################################
# 6. LIST ITEMS
########################################################################

### 6a. Add Ground Beef to the list  → expect 200
# @name item
POST {{host}}/api/listitem
Authorization: Bearer {{alice.response.body.$.token}}
Content-Type: application/json

{
  "shoppingListId": {{list.response.body.$.id}},
  "productId": {{beef.response.body.$.id}},
  "quantity": 2
}

### 6b. Check the item off  → expect 200, isChecked true, quantity still 2
PATCH {{host}}/api/listitem/{{item.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}
Content-Type: application/json

{
  "isChecked": true
}

### 6c. Bob tries to edit Alice's list item  → expect 403
PATCH {{host}}/api/listitem/{{item.response.body.$.id}}
Authorization: Bearer {{bob.response.body.$.token}}
Content-Type: application/json

{
  "quantity": 99
}

### 6d. Add Ground Turkey to the list (left unchecked)  → expect 200
# @name turkeyItem
POST {{host}}/api/listitem
Authorization: Bearer {{alice.response.body.$.token}}
Content-Type: application/json

{
  "shoppingListId": {{list.response.body.$.id}},
  "productId": {{turkey.response.body.$.id}},
  "quantity": 1
}

########################################################################
# 7. LIST DETAIL  — GET /api/shoppinglist/{id} (list + its items)
########################################################################

### 7a. Alice gets the list with items  → expect 200, listItems has 2 entries
###     ORDER: "Ground Turkey 93/7" FIRST (unchecked), "Ground Beef" LAST (checked)
###     Alphabetically beef would come first, so this proves unchecked-first sorting.
###     Each item shows productName, price (6.49 / 7.99), imageUrl null, quantity, isChecked.
GET {{host}}/api/shoppinglist/{{list.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}

### 7b. Uncheck Ground Beef  → expect 200, isChecked false
PATCH {{host}}/api/listitem/{{item.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}
Content-Type: application/json

{
  "isChecked": false
}

### 7c. Get the list again  → expect 200, both unchecked, now alphabetical:
###     "Ground Beef" first, then "Ground Turkey 93/7"
GET {{host}}/api/shoppinglist/{{list.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}

### 7d. Alice creates a second, empty list  → expect 200
# @name emptyList
POST {{host}}/api/shoppinglist
Authorization: Bearer {{alice.response.body.$.token}}
Content-Type: application/json

{
  "listName": "Empty List",
  "familyId": {{aliceFamily.response.body.$.id}},
  "storeId": {{aliceStore.response.body.$.id}}
}

### 7e. Get the empty list  → expect 200, "listItems": []  (empty array, NOT null)
GET {{host}}/api/shoppinglist/{{emptyList.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}

### 7f. Bob tries to get Alice's list  → expect 403
GET {{host}}/api/shoppinglist/{{list.response.body.$.id}}
Authorization: Bearer {{bob.response.body.$.token}}

### 7g. List that doesn't exist  → expect 404 "Shopping List not found."
GET {{host}}/api/shoppinglist/999999
Authorization: Bearer {{alice.response.body.$.token}}

########################################################################
# 8. INVITE  — Bob joins Alice's family, then CAN see her data
########################################################################

### 8a. Alice adds Bob by email  → expect 200
POST {{host}}/api/family/{{aliceFamily.response.body.$.id}}/invite
Authorization: Bearer {{alice.response.body.$.token}}
Content-Type: application/json

{
  "email": "bob@test.com"
}

### 8b. Bob lists Alice's stores now  → expect 200 (was 403 in 3d)
GET {{host}}/api/store/{{aliceFamily.response.body.$.id}}
Authorization: Bearer {{bob.response.body.$.token}}

### 8c. Bob lists his families  → expect 200, BOTH households
GET {{host}}/api/family
Authorization: Bearer {{bob.response.body.$.token}}

### 8d. Bob gets Alice's list now  → expect 200 with both items (was 403 in 7f)
GET {{host}}/api/shoppinglist/{{list.response.body.$.id}}
Authorization: Bearer {{bob.response.body.$.token}}

########################################################################
# 9. SOFT DELETE  — deleting a product archives it (ArchivedAt) instead
#    of removing the row, so lists that already contain it keep working.
#    State going in: the list has Ground Beef (unchecked) + Ground Turkey.
########################################################################

### 9a. Delete Ground Beef WHILE it's still on the list  → expect 204 (this used to be a 500)
DELETE {{host}}/api/product/{{beef.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}

### 9b. List products in Alice's store  → expect 200, ONLY "Ground Turkey 93/7"
GET {{host}}/api/product/store/{{aliceStore.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}

### 9c. Search "ground"  → expect 200, ONLY "Ground Turkey 93/7"
GET {{host}}/api/product/search?storeId={{aliceStore.response.body.$.id}}&query=ground
Authorization: Bearer {{alice.response.body.$.token}}

### 9d. Get the list  → expect 200, BOTH items still there
###     Ground Beef: "isArchived": true    Ground Turkey: "isArchived": false
GET {{host}}/api/shoppinglist/{{list.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}

### 9e. Add archived Ground Beef to the empty list  → expect 404 "Product not found"
POST {{host}}/api/listitem
Authorization: Bearer {{alice.response.body.$.token}}
Content-Type: application/json

{
  "shoppingListId": {{emptyList.response.body.$.id}},
  "productId": {{beef.response.body.$.id}},
  "quantity": 1
}

### 9f. Edit archived Ground Beef  → expect 404 "Product not found"
PATCH {{host}}/api/product/{{beef.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}
Content-Type: application/json

{
  "price": 8.99
}

### 9g. Delete Ground Beef again  → expect 404 "Product is already archived"
DELETE {{host}}/api/product/{{beef.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}

### 9h. Check off the archived beef item on the existing list  → expect 200, isChecked true
###     (shoppers can still finish a list after a product is archived)
PATCH {{host}}/api/listitem/{{item.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}
Content-Type: application/json

{
  "isChecked": true
}

########################################################################
# 10. CLEANUP / DELETES
# Products are soft-deleted now, so order no longer matters for them.
# Archived products stay in the database across re-runs — that's expected.
########################################################################

### 10a. Delete the beef list item  → expect 204
DELETE {{host}}/api/listitem/{{item.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}

### 10b. Delete the turkey list item  → expect 204
DELETE {{host}}/api/listitem/{{turkeyItem.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}

### 10c. Delete (archive) the turkey product  → expect 204
DELETE {{host}}/api/product/{{turkey.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}

### 10d. Delete the shopping list  → expect 204
DELETE {{host}}/api/shoppinglist/{{list.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}

### 10e. Delete the empty list  → expect 204
DELETE {{host}}/api/shoppinglist/{{emptyList.response.body.$.id}}
Authorization: Bearer {{alice.response.body.$.token}}

########################################################################
# 11. SIGNALR HUB  — /hubs/family
# "negotiate" is the first HTTP request every SignalR client makes before
# opening the WebSocket, so it's a quick way to check the hub is mapped
# and that auth works. (Real-time events need the test client — later.)
########################################################################

### 11a. Negotiate with NO token  → expect 401 (hub has [Authorize])
POST {{host}}/hubs/family/negotiate?negotiateVersion=1

### 11b. Negotiate with token in the QUERY STRING  → expect 200
###      Body has "connectionId", "connectionToken" and "availableTransports"
###      (WebSockets should be listed). This proves OnMessageReceived works.
POST {{host}}/hubs/family/negotiate?negotiateVersion=1&access_token={{alice.response.body.$.token}}

### 11c. Negotiate with token in the HEADER  → expect 200
###      (plain HTTP requests can still use the normal header)
POST {{host}}/hubs/family/negotiate?negotiateVersion=1
Authorization: Bearer {{alice.response.body.$.token}}

### 11d. Garbage token in the query string  → expect 401
POST {{host}}/hubs/family/negotiate?negotiateVersion=1&access_token=not-a-real-token

### 11e. Token in the query string on a REST endpoint  → expect 401
###      The path check limits query-string tokens to /hubs only.
GET {{host}}/api/family?access_token={{alice.response.body.$.token}}
